func main
	C_LINESIZE = 80
	? copy("=",C_LINESIZE)
	? "RingUTF8Proc Package"
	? copy("=",C_LINESIZE)
	? "RingUTF8Proc package (Unicode using utf8proc) for the Ring programming language"
	? "See the folder : ring/libraries/utf8proclib"
	? "See the folder : ring/extensions/ringutf8proc"
	? "See the folder : ring/samples/UsingUTF8Proc"
	? copy("=",C_LINESIZE)
