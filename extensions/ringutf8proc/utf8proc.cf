<code>
/*
**  RingUTF8Proc - utf8proc Extension for the Ring Programming Language
**  Unicode normalization, case mapping, grapheme clusters and character properties
*/

/* The build scripts define UTF8PROC_STATIC (utf8proc is compiled into the extension) */
#include "utf8proc/utf8proc.h"

/* Largest valid Unicode codepoint */
#define RING_UTF8PROC_MAXCODEPOINT 0x10FFFF

/* Size of the buffer used by utf8proc_decompose_char() */
#define RING_UTF8PROC_DECOMPOSESIZE 64

/* Maximum bytes of one encoded codepoint */
#define RING_UTF8PROC_MAXCHARBYTES 4

/* Largest input (in bytes) that functions which allocate RING_UTF8PROC_MAXCHARBYTES per byte accept */
#define RING_UTF8PROC_MAXINPUT ((utf8proc_ssize_t) (INT_MAX / RING_UTF8PROC_MAXCHARBYTES) - 1)

/* The replacement character U+FFFD in UTF-8 */
#define RING_UTF8PROC_REPLACEMENT "\xEF\xBF\xBD"
#define RING_UTF8PROC_REPLACEMENTSIZE 3

/* Codepoints used to compute the display width of grapheme clusters */
#define RING_UTF8PROC_EMOJIPRESENTATION 0xFE0F
#define RING_UTF8PROC_FIRSTREGIONAL 0x1F1E6
#define RING_UTF8PROC_LASTREGIONAL 0x1F1FF
#define RING_UTF8PROC_WIDEWIDTH 2

/* Arabic presentation forms (the form numbers used by utf8proc_arabicform()) */
#define RING_UTF8PROC_FORMISOLATED 1
#define RING_UTF8PROC_FORMFINAL 2
#define RING_UTF8PROC_FORMINITIAL 3
#define RING_UTF8PROC_FORMMEDIAL 4

/* Arabic joining types (returned by utf8proc_arabicjoiningtype()) */
#define RING_UTF8PROC_JOINNONE 0
#define RING_UTF8PROC_JOINRIGHT 1
#define RING_UTF8PROC_JOINDUAL 2
#define RING_UTF8PROC_JOINCAUSING 3
#define RING_UTF8PROC_JOINTRANSPARENT 4

/* Paragraph directions used by utf8proc_bidivisual() */
#define RING_UTF8PROC_DIRECTIONAUTO 0
#define RING_UTF8PROC_DIRECTIONLTR 1
#define RING_UTF8PROC_DIRECTIONRTL 2

/* Apostrophes that can join the parts of a word (like don't) */
#define RING_UTF8PROC_APOSTROPHE 0x27
#define RING_UTF8PROC_RIGHTQUOTE 0x2019

/* Prefix of the errors raised by the extension */
#define RING_UTF8PROC_ERRORPREFIX "utf8proc Error: "

/* Size of the buffer used to build error messages */
#define RING_UTF8PROC_ERRORSIZE 256

/* Raise a Ring error that contains the utf8proc error message */
static void ringutf8proc_error ( void *pPointer, utf8proc_ssize_t nError )
{
	char cError[RING_UTF8PROC_ERRORSIZE] ;
	snprintf(cError,RING_UTF8PROC_ERRORSIZE,"%s%s",RING_UTF8PROC_ERRORPREFIX,utf8proc_errmsg(nError));
	RING_API_ERROR(cError);
}

/* Check that the parameter is a number inside the codepoint range */
static int ringutf8proc_iscodepoint ( void *pPointer, int nPara )
{
	double nValue ;
	if ( ! RING_API_ISNUMBER(nPara) ) {
		return 0 ;
	}
	nValue = RING_API_GETNUMBER(nPara);
	return (nValue >= 0) && (nValue <= RING_UTF8PROC_MAXCODEPOINT) ;
}

/* Check that the function received one string parameter */
static int ringutf8proc_checkstring ( void *pPointer )
{
	if ( RING_API_PARACOUNT != 1 ) {
		RING_API_ERROR(RING_API_MISS1PARA);
		return 0 ;
	}
	if ( ! RING_API_ISSTRING(1) ) {
		RING_API_ERROR(RING_API_BADPARATYPE);
		return 0 ;
	}
	return 1 ;
}

/*
**  Read the codepoint that starts at byte nPos
**  Returns the number of bytes read (0 at the end of the string) or a negative error code
*/
static utf8proc_ssize_t ringutf8proc_next ( const char *cStr, utf8proc_ssize_t nSize, utf8proc_ssize_t nPos, utf8proc_int32_t *pCode )
{
	*pCode = -1 ;
	if ( nPos >= nSize ) {
		return 0 ;
	}
	return utf8proc_iterate((const utf8proc_uint8_t *) cStr + nPos,nSize - nPos,pCode) ;
}

/*
**  Map the string with utf8proc_map() and return the result
**  The input length is used, so strings that contain char(0) are processed
*/
static void ringutf8proc_retmap ( void *pPointer, const char *cStr, utf8proc_ssize_t nSize, unsigned int nOptions )
{
	utf8proc_uint8_t *pOutput ;
	utf8proc_ssize_t nResult ;
	pOutput = NULL ;
	nResult = utf8proc_map((const utf8proc_uint8_t *) cStr,nSize,&pOutput,nOptions);
	if ( nResult < 0 ) {
		ringutf8proc_error(pPointer,nResult);
		return ;
	}
	RING_API_RETSTRING2((const char *) pOutput,(unsigned int) nResult);
	utf8proc_free(pOutput);
}

/* Map the string parameter using the given options */
static void ringutf8proc_mapparameter ( void *pPointer, unsigned int nOptions )
{
	if ( ! ringutf8proc_checkstring(pPointer) ) {
		return ;
	}
	ringutf8proc_retmap(pPointer,RING_API_GETSTRING(1),RING_API_GETSTRINGSIZE(1),nOptions);
}

/*
**  Read the codepoint parameter (the only parameter of the function)
**  Raises an error for a missing parameter, a parameter that is not a number,
**  or a number outside the range 0 to 0x10FFFF
*/
static int ringutf8proc_getcodeparameter ( void *pPointer, utf8proc_int32_t *pCode )
{
	if ( RING_API_PARACOUNT != 1 ) {
		RING_API_ERROR(RING_API_MISS1PARA);
		return 0 ;
	}
	if ( ! RING_API_ISNUMBER(1) ) {
		RING_API_ERROR(RING_API_BADPARATYPE);
		return 0 ;
	}
	if ( ! ringutf8proc_iscodepoint(pPointer,1) ) {
		RING_API_ERROR(RING_API_BADPARARANGE);
		return 0 ;
	}
	*pCode = (utf8proc_int32_t) RING_API_GETNUMBER(1);
	return 1 ;
}

/* Check that the output buffer of RING_UTF8PROC_MAXCHARBYTES per input byte can be allocated */
static int ringutf8proc_checksize ( void *pPointer, utf8proc_ssize_t nSize )
{
	if ( nSize > RING_UTF8PROC_MAXINPUT ) {
		ringutf8proc_error(pPointer,UTF8PROC_ERROR_OVERFLOW);
		return 0 ;
	}
	return 1 ;
}

/* Return true if the codepoint is a letter, a mark or a number (part of a word) */
static int ringutf8proc_iswordchar ( utf8proc_int32_t nCode )
{
	utf8proc_category_t nCategory ;
	nCategory = utf8proc_category(nCode);
	return (nCategory >= UTF8PROC_CATEGORY_LU) && (nCategory <= UTF8PROC_CATEGORY_NO) ;
}

/* Return true for the apostrophes that can join the parts of a word (like don't) */
static int ringutf8proc_isapostrophe ( utf8proc_int32_t nCode )
{
	return (nCode == RING_UTF8PROC_APOSTROPHE) || (nCode == RING_UTF8PROC_RIGHTQUOTE) ;
}

/* Iterator over the grapheme clusters (UAX 29) of a string */
typedef struct RingUTF8ProcGraphemes {
	const char *cStr ;
	utf8proc_ssize_t nSize ;
	/* Position and size of the next codepoint (read ahead) */
	utf8proc_ssize_t nPos ;
	utf8proc_ssize_t nBytes ;
	utf8proc_int32_t nCode ;
	/* State of utf8proc_grapheme_break_stateful() */
	utf8proc_int32_t nState ;
} RingUTF8ProcGraphemes ;

static void ringutf8proc_graphemesinit ( RingUTF8ProcGraphemes *pIter, const char *cStr, utf8proc_ssize_t nSize )
{
	pIter->cStr = cStr ;
	pIter->nSize = nSize ;
	pIter->nPos = 0 ;
	pIter->nState = 0 ;
	pIter->nBytes = ringutf8proc_next(cStr,nSize,0,&pIter->nCode);
}

/*
**  Find the next grapheme cluster: the bytes from *pStart to *pEnd (not included)
**  Returns 1 if a cluster is found, 0 at the end of the string, or a negative error code
*/
static utf8proc_ssize_t ringutf8proc_graphemesnext ( RingUTF8ProcGraphemes *pIter, utf8proc_ssize_t *pStart, utf8proc_ssize_t *pEnd )
{
	utf8proc_int32_t nPrevCode ;
	if ( pIter->nBytes <= 0 ) {
		return pIter->nBytes ;
	}
	*pStart = pIter->nPos ;
	while ( 1 ) {
		nPrevCode = pIter->nCode ;
		pIter->nPos += pIter->nBytes ;
		pIter->nBytes = ringutf8proc_next(pIter->cStr,pIter->nSize,pIter->nPos,&pIter->nCode);
		if ( pIter->nBytes < 0 ) {
			return pIter->nBytes ;
		}
		if ( (pIter->nBytes == 0) || utf8proc_grapheme_break_stateful(nPrevCode,pIter->nCode,&pIter->nState) ) {
			break ;
		}
	}
	*pEnd = pIter->nPos ;
	return 1 ;
}

/*
**  Display width (terminal columns) of the grapheme cluster cStr[nStart..nEnd)
**  The cluster takes the width of its widest codepoint (emoji sequences use 2 columns, not the sum)
**  An emoji presentation selector (U+FE0F) and a flag (two regional indicators) use 2 columns
*/
static int ringutf8proc_graphemewidth ( const char *cStr, utf8proc_ssize_t nStart, utf8proc_ssize_t nEnd )
{
	utf8proc_ssize_t nBytes ;
	utf8proc_int32_t nCode ;
	int nWidth, nCharWidth, nRegional ;
	nWidth = 0 ;
	nRegional = 0 ;
	while ( (nBytes = ringutf8proc_next(cStr,nEnd,nStart,&nCode)) > 0 ) {
		nStart += nBytes ;
		if ( (nCode == RING_UTF8PROC_EMOJIPRESENTATION) ||
		     ((nCode >= RING_UTF8PROC_FIRSTREGIONAL) && (nCode <= RING_UTF8PROC_LASTREGIONAL) && (++nRegional == 2)) ) {
			nCharWidth = RING_UTF8PROC_WIDEWIDTH ;
		}
		else {
			nCharWidth = utf8proc_charwidth(nCode);
		}
		if ( nCharWidth > nWidth ) {
			nWidth = nCharWidth ;
		}
	}
	return nWidth ;
}

/* Return true if the grapheme cluster cStr[nStart..nEnd) starts with a space separator */
static int ringutf8proc_graphemeisspace ( const char *cStr, utf8proc_ssize_t nStart, utf8proc_ssize_t nEnd )
{
	utf8proc_int32_t nCode ;
	utf8proc_ssize_t nBytes ;
	nBytes = ringutf8proc_next(cStr,nEnd,nStart,&nCode);
	/* A space followed by a combining character (one cluster) is not a space */
	return (nStart + nBytes == nEnd) && (utf8proc_category(nCode) == UTF8PROC_CATEGORY_ZS) ;
}

/* Category of the first codepoint of the grapheme cluster cStr[nStart..nEnd) */
static utf8proc_category_t ringutf8proc_graphemecategory ( const char *cStr, utf8proc_ssize_t nStart, utf8proc_ssize_t nEnd )
{
	utf8proc_int32_t nCode ;
	ringutf8proc_next(cStr,nEnd,nStart,&nCode);
	return utf8proc_category(nCode) ;
}

/* Return true for punctuation that should not start a line (closing brackets and quotes, full stops, commas) */
static int ringutf8proc_isclosingpunct ( utf8proc_category_t nCategory )
{
	return (nCategory == UTF8PROC_CATEGORY_PE) || (nCategory == UTF8PROC_CATEGORY_PF) || (nCategory == UTF8PROC_CATEGORY_PO) ;
}

/* Return true if the grapheme cluster that starts at cStr[nStart] is a line break (LF, CR or CR LF) */
static int ringutf8proc_graphemeisnewline ( const char *cStr, utf8proc_ssize_t nStart )
{
	return (cStr[nStart] == '\n') || (cStr[nStart] == '\r') ;
}

/* Case conversion modes used by ringutf8proc_convertcase() */
#define RING_UTF8PROC_CASELOWER 1
#define RING_UTF8PROC_CASEUPPER 2
#define RING_UTF8PROC_CASETITLE 3

/* Convert the case of each codepoint in the string parameter (simple one to one case mapping) */
static void ringutf8proc_convertcase ( void *pPointer, int nMode )
{
	const char *cStr ;
	utf8proc_uint8_t *pOutput ;
	utf8proc_ssize_t nSize, nPos, nBytes, nOutSize ;
	utf8proc_int32_t nCode ;
	int lWordStart ;
	if ( ! ringutf8proc_checkstring(pPointer) ) {
		return ;
	}
	cStr = RING_API_GETSTRING(1);
	nSize = RING_API_GETSTRINGSIZE(1);
	if ( ! ringutf8proc_checksize(pPointer,nSize) ) {
		return ;
	}
	pOutput = (utf8proc_uint8_t *) RING_API_MALLOC(nSize * RING_UTF8PROC_MAXCHARBYTES + 1);
	if ( pOutput == NULL ) {
		ringutf8proc_error(pPointer,UTF8PROC_ERROR_NOMEM);
		return ;
	}
	nPos = 0 ;
	nOutSize = 0 ;
	lWordStart = 1 ;
	while ( (nBytes = ringutf8proc_next(cStr,nSize,nPos,&nCode)) > 0 ) {
		nPos += nBytes ;
		if ( nMode == RING_UTF8PROC_CASELOWER ) {
			nCode = utf8proc_tolower(nCode);
		}
		else if ( nMode == RING_UTF8PROC_CASEUPPER ) {
			nCode = utf8proc_toupper(nCode);
		}
		else if ( ringutf8proc_iswordchar(nCode) ) {
			nCode = lWordStart ? utf8proc_totitle(nCode) : utf8proc_tolower(nCode) ;
			lWordStart = 0 ;
		}
		else if ( ! ( ringutf8proc_isapostrophe(nCode) && ! lWordStart ) ) {
			/* An apostrophe inside a word (like don't) doesn't start a new word */
			lWordStart = 1 ;
		}
		nOutSize += utf8proc_encode_char(nCode,pOutput + nOutSize);
	}
	if ( nBytes < 0 ) {
		RING_API_FREE(pOutput);
		ringutf8proc_error(pPointer,nBytes);
		return ;
	}
	RING_API_RETSTRING2((const char *) pOutput,(unsigned int) nOutSize);
	RING_API_FREE(pOutput);
}
</code>

